NEXT_PUBLIC_SITE_URL=https://kudziemuks.com
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/kudziemuks/strategy-call
NEXT_PUBLIC_WHATSAPP_NUMBER=263779297141
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_PORTRAIT_SRC=/kudzaishe.jpg

# --- Client Setup form: Google Cloud auth via Vercel OIDC + Workload Identity Federation ---
# Authenticates via Vercel OIDC + Google Workload Identity Federation,
# impersonating GOOGLE_SERVICE_ACCOUNT_EMAIL. No service-account private key
# is used or stored. See Google Cloud Console > IAM & Admin > Workload
# Identity Federation for these values.
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=000000000000
GOOGLE_WORKLOAD_IDENTITY_POOL_ID=your-pool-id
GOOGLE_WORKLOAD_IDENTITY_PROVIDER_ID=your-provider-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Only needed if your Workload Identity provider uses a custom/"Default
# audience" instead of the "Allowed audiences" option set to Vercel's own
# default (https://vercel.com/<team-slug>) — leave blank otherwise.
VERCEL_OIDC_AUDIENCE=

# The Google Sheet that receives client-setup submissions and setup links
# (its ID is the long string in its URL between /d/ and /edit).
CLIENT_SETUP_SPREADSHEET_ID=

# The Drive folder (shared with the service account) under which
# "Kudziemuks Clients/<Client>/<Campaign>/..." folders are created — just
# the folder ID, not the full share-link URL.
CLIENT_SETUP_DRIVE_ROOT_FOLDER_ID=

# For local development only: run `vercel link` then `vercel env pull` to
# populate this from your linked Vercel project. Not needed in production —
# Vercel provides it to each Function automatically. NEVER commit a real
# value here — it's a live bearer token.
VERCEL_OIDC_TOKEN=

# --- Admin login (server-side only — never exposed to the browser) ---
# Generate with: node scripts/hash-admin-password.mjs "your-password"
ADMIN_PASSWORD_HASH=
# Any long random string, e.g: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
