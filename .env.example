# Copy to .env.local and fill in real values. Never commit real secrets here —
# this file is public. Real values live in Vercel and in .env.local (gitignored).

# Admin login
ADMIN_PASSWORD_HASH="scrypt:<salt>:<hash>"
ADMIN_SESSION_SECRET="<random 64-character hex string>"

# Google Sheets / Drive
CLIENT_SETUP_DRIVE_ROOT_FOLDER_ID=""
CLIENT_SETUP_SPREADSHEET_ID=""
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_CLOUD_PROJECT_NUMBER=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WORKLOAD_IDENTITY_POOL_ID=""
GOOGLE_WORKLOAD_IDENTITY_PROVIDER_ID=""

# Public site settings
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/kudziemuks/strategy-call"
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# WhatsApp alerts for new "Work with me" leads (Meta WhatsApp Cloud API).
# Leave blank to skip alerts — leads are still saved to the sheet. See README.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Your own number, international format, digits only (e.g. 263779297141).
WHATSAPP_NOTIFY_TO=""
# Approved template name, e.g. new_lead_alert. Blank sends plain text (test only).
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_GRAPH_VERSION="v23.0"
